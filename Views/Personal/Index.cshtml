
@model IEnumerable<Huellitas.Models.Personal>

@{
    ViewData["Title"] = "Gestión del personal";
    var cargos = ViewBag.Cargos as Dictionary<int, string>
        ?? new Dictionary<int, string>();
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Gestión del personal</h2>
            <p class="text-muted">
                Administración de veterinarios y recepcionistas.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus"></i>
            Registrar personal
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Mensaje"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Todavía no hay personal registrado.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Nombre completo</th>
                            <th>Correo de usuario</th>
                            <th>Cargo</th>
                            <th>Teléfono</th>
                            <th>Especialidad</th>
                            <th>Fecha contratación</th>
                            <th>Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var persona in Model)
                        {
                            var cargo = cargos.ContainsKey(persona.Id)
                                ? cargos[persona.Id]
                                : "Sin cargo";

                            <tr>
                                <td>
                                    <strong>
                                        @persona.Nombres @persona.Apellidos
                                    </strong>
                                </td>

                                <td>
                                    @persona.Usuario?.Email
                                </td>

                                <td>
                                    @if (cargo == "Veterinario")
                                    {
                                        <span class="badge bg-primary">
                                            <i class="bi bi-heart-pulse"></i>
                                            Veterinario
                                        </span>
                                    }
                                    else if (cargo == "Recepcionista")
                                    {
                                        <span class="badge bg-info text-dark">
                                            <i class="bi bi-person-badge"></i>
                                            Recepcionista
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Sin cargo
                                        </span>
                                    }
                                </td>

                                <td>
                                    @persona.Telefono
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(persona.Especialidad)
                                        ? "No especificada"
                                        : persona.Especialidad)
                                </td>

                                <td>
                                    @persona.FechaContratacion.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @if (persona.EstadoLaboral == "Activo")
                                    {
                                        <span class="badge bg-success">
                                            Activo
                                        </span>
                                    }
                                    else if (persona.EstadoLaboral == "Vacaciones")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Vacaciones
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactivo
                                        </span>
                                    }
                                </td>

                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2 flex-wrap">

                                        <a asp-controller="HorariosPersonal"
                                           asp-action="Index"
                                           asp-route-personalId="@persona.Id"
                                           class="btn btn-sm btn-outline-success">
                                            <i class="bi bi-calendar-week"></i>
                                            Ver horarios
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@persona.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil"></i>
                                            Editar
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@persona.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                            Eliminar
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    }
</div>