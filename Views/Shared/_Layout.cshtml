
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Huellitas</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Huellitas.styles.css" asp-append-version="true" />
</head>

<body>

@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <div class="app-layout">

        <!-- MENÚ LATERAL -->
        <aside class="sidebar offcanvas-lg offcanvas-start"
               tabindex="-1"
               id="sidebarMenu"
               aria-labelledby="sidebarTitle">

            <div class="sidebar-header">

                <a class="sidebar-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="brand-icon">🐾</span>

                    <span class="brand-text">
                        <strong id="sidebarTitle">HUELLITAS</strong>
                        <small>Gestión veterinaria</small>
                    </span>
                </a>

                <button type="button"
                        class="btn-close btn-close-white d-lg-none"
                        data-bs-dismiss="offcanvas"
                        aria-label="Cerrar menú">
                </button>

            </div>

            <div class="sidebar-content">

                <nav class="sidebar-nav">

                    <div class="sidebar-section-title">
                        GENERAL
                    </div>

                    <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                       asp-controller="Home"
                       asp-action="Index">

                        <span class="sidebar-icon">⌂</span>
                        <span>Inicio</span>
                    </a>

                    @if (User.IsInRole("Administrador"))
                    {
                        <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
                           asp-controller="Dashboard"
                           asp-action="Index">

                            <span class="sidebar-icon">▦</span>
                            <span>Estadísticas</span>
                        </a>
                    }

                    <div class="sidebar-section-title">
                        GESTIÓN VETERINARIA
                    </div>

                    <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Propietarios" ? "active" : "")"
                       asp-controller="Propietarios"
                       asp-action="Index">

                        <span class="sidebar-icon">♙</span>
                        <span>Propietarios</span>
                    </a>

                    <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Mascotas" ? "active" : "")"
                       asp-controller="Mascotas"
                       asp-action="Index">

                        <span class="sidebar-icon">🐾</span>
                        <span>Mascotas</span>
                    </a>

                    <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Citas" ? "active" : "")"
                       asp-controller="Citas"
                       asp-action="Index">

                        <span class="sidebar-icon">▣</span>
                        <span>Citas</span>
                    </a>

                    @if (User.IsInRole("Administrador") ||
                         User.IsInRole("Veterinario"))
                    {
                        <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Consultas" ? "active" : "")"
                           asp-controller="Consultas"
                           asp-action="Index">

                            <span class="sidebar-icon">✚</span>
                            <span>Consultas médicas</span>
                        </a>
                    }

                    @if (User.IsInRole("Administrador"))
                    {
                        <div class="sidebar-section-title">
                            ADMINISTRACIÓN
                        </div>

                        <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Personal" ? "active" : "")"
                           asp-controller="Personal"
                           asp-action="Index">

                            <span class="sidebar-icon">♧</span>
                            <span>Personal</span>
                        </a>

                        <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Usuarios" ? "active" : "")"
                           asp-controller="Usuarios"
                           asp-action="Create">

                            <span class="sidebar-icon">♙</span>
                            <span>Usuarios</span>
                        </a>
                    }

                </nav>
            </div>

            <!-- PERFIL Y CIERRE DE SESIÓN -->
            <div class="sidebar-footer">

                <div class="user-info">

                    <div class="user-avatar">
                        @(string.IsNullOrEmpty(User.Identity.Name)
                            ? "U"
                            : User.Identity.Name.Substring(0, 1).ToUpper())
                    </div>

                    <div class="user-details">
                        <strong>@User.Identity.Name</strong>
                        <small>Sesión activa</small>
                    </div>

                </div>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    <button type="submit" class="logout-button">
                        <span>↪</span>
                        Cerrar sesión
                    </button>

                </form>

            </div>

        </aside>

        <!-- CONTENIDO PRINCIPAL -->
        <div class="main-wrapper">

            <header class="topbar">

                <div class="topbar-left">

                    <button class="menu-toggle d-lg-none"
                            type="button"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#sidebarMenu"
                            aria-controls="sidebarMenu"
                            aria-label="Abrir menú">

                        ☰

                    </button>

                    <div class="topbar-title">
                        <span>Panel de gestión</span>
                        <small>Sistema veterinario HUELLITAS</small>
                    </div>

                </div>

                <div class="topbar-user">
                    <span class="status-indicator"></span>
                    <span>Conectado</span>
                </div>

            </header>

            <main role="main" class="main-content">
                @RenderBody()
            </main>

            <footer class="app-footer">
                © 2026 HUELLITAS · Sistema de Gestión Veterinaria
            </footer>

        </div>

    </div>
}
else
{
    <main role="main" class="auth-layout">
        @RenderBody()
    </main>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>