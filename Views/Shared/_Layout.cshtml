
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Huellitas</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Huellitas.styles.css" asp-append-version="true" />
</head>

<body>

@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <div class="app-layout">

        <!-- NAVEGACIÓN PRINCIPAL -->
        <header class="main-header">

            <div class="navbar-main">

                <!-- MARCA -->
                <a class="navbar-brand-custom"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="brand-icon">🐾</span>

                    <span class="brand-text">
                        <strong>HUELLITAS</strong>
                        <small>Gestión veterinaria</small>
                    </span>

                </a>

                <!-- ENLACES DE NAVEGACIÓN -->
                <nav class="main-navigation">

                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                       asp-controller="Home"
                       asp-action="Index">
                        <span>⌂</span>
                        Inicio
                    </a>

                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Propietarios" ? "active" : "")"
                       asp-controller="Propietarios"
                       asp-action="Index">
                        <span>♙</span>
                        Propietarios
                    </a>

                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Mascotas" ? "active" : "")"
                       asp-controller="Mascotas"
                       asp-action="Index">
                        <span>🐾</span>
                        Mascotas
                    </a>

                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Citas" ? "active" : "")"
                       asp-controller="Citas"
                       asp-action="Index">
                        <span>▣</span>
                        Citas
                    </a>

                    @if (User.IsInRole("Administrador"))
                    {
                        <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
                           asp-controller="Dashboard"
                           asp-action="Index">
                            <span>▦</span>
                            Estadísticas
                        </a>
                    }

                    @if (User.IsInRole("Administrador") ||
                         User.IsInRole("Veterinario"))
                    {
                        <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Consultas" ? "active" : "")"
                           asp-controller="Consultas"
                           asp-action="Index">
                            <span>✚</span>
                            Consultas
                        </a>
                    }

                    @if (User.IsInRole("Administrador"))
                    {
                        <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Personal" ? "active" : "")"
                           asp-controller="Personal"
                           asp-action="Index">
                            <span>♧</span>
                            Personal
                        </a>

                        <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Usuarios" ? "active" : "")"
                           asp-controller="Usuarios"
                           asp-action="Create">
                            <span>♙</span>
                            Usuarios
                        </a>
                    }

                </nav>

                <!-- USUARIO Y CIERRE DE SESIÓN -->
                <div class="navbar-user">

                    <div class="user-status">
                        <span class="status-indicator"></span>
                        <span>Conectado</span>
                    </div>

                    <div class="user-profile">
                        <div class="user-avatar">
                            @(string.IsNullOrEmpty(User.Identity.Name)
                                ? "U"
                                : User.Identity.Name.Substring(0, 1).ToUpper())
                        </div>

                        <div class="user-details">
                            <strong>@User.Identity.Name</strong>
                            <small>Sesión activa</small>
                        </div>
                    </div>

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post">

                        <button type="submit" class="logout-button"
                                title="Cerrar sesión">
                            <span>↪</span>
                            <span class="logout-text">Salir</span>
                        </button>

                    </form>

                </div>

            </div>

        </header>

        <!-- CONTENIDO PRINCIPAL -->
        <main role="main" class="main-content">
            @RenderBody()
        </main>

        <!-- PIE DE PÁGINA -->
        <footer class="app-footer">
            © 2026 HUELLITAS · Sistema de Gestión Veterinaria
        </footer>

    </div>
}
else
{
    <main role="main" class="auth-layout">
        @RenderBody()
    </main>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
