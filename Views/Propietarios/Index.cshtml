
@model IEnumerable<Huellitas.Models.Propietario>

@{
    ViewData["Title"] = "Propietarios";
}

<div class="container py-4">

    <!-- Encabezado -->
    <div class="d-flex flex-column flex-md-row
                justify-content-between align-items-md-center mb-4">

        <div>
            <h2 class="fw-bold text-dark mb-1">
                👥 Gestión de propietarios
            </h2>

            <p class="text-muted mb-0">
                Administra la información de los propietarios registrados.
            </p>
        </div>

        <div class="mt-3 mt-md-0">
            <a asp-action="Create"
               class="btn btn-success px-4 shadow-sm">
                + Registrar propietario
            </a>
        </div>

    </div>

    <!-- Tabla -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <div class="card-header bg-white border-0 p-3">
            <h5 class="fw-bold mb-0">
                Listado de propietarios
            </h5>
            <small class="text-muted">
                Información registrada en HUELLITAS
            </small>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead style="background-color: #176B5B; color: white;">
                        <tr>
                            <th class="py-3 ps-3">Nombres</th>
                            <th class="py-3">Apellidos</th>
                            <th class="py-3">Teléfono</th>
                            <th class="py-3">Correo</th>
                            <th class="py-3">Dirección</th>
                            <th class="py-3 text-center">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var propietario in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold">
                                    @propietario.Nombres
                                </td>

                                <td>@propietario.Apellidos</td>

                                <td>@propietario.Telefono</td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(propietario.Correo))
                                    {
                                        @propietario.Correo
                                    }
                                    else
                                    {
                                        <span class="text-muted">No registrado</span>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(propietario.Direccion))
                                    {
                                        @propietario.Direccion
                                    }
                                    else
                                    {
                                        <span class="text-muted">No registrada</span>
                                    }
                                </td>

                                <td class="text-center text-nowrap">

                                    <a asp-action="Edit"
                                       asp-route-id="@propietario.Id"
                                       class="btn btn-outline-warning btn-sm me-1">
                                        ✏️ Editar
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@propietario.Id"
                                       class="btn btn-outline-danger btn-sm">
                                        🗑️ Eliminar
                                    </a>

                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center p-5">
                <div class="display-3 mb-3">👥</div>

                <h5 class="fw-bold">
                    No hay propietarios registrados
                </h5>

                <p class="text-muted">
                    Cuando registres un propietario, aparecerá en este listado.
                </p>

                <a asp-action="Create" class="btn btn-success px-4">
                    Registrar primer propietario
                </a>
            </div>
        }

    </div>

</div>