
@model IEnumerable<Huellitas.Models.Consulta>

@{
    ViewData["Title"] = "Consultas";
}

<h1>Historial de consultas</h1>

<p>Registro de consultas médicas de las mascotas.</p>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">
        + Registrar nueva consulta
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Todavía no hay consultas registradas.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Mascota</th>
                    <th>Propietario</th>
                    <th>Fecha</th>
                    <th>Motivo</th>
                    <th>Diagnóstico</th>
                    <th>Cita asociada</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var consulta in Model)
                {
                    <tr>
                        <td>@consulta.Mascota?.Nombre</td>

                        <td>
                            @consulta.Mascota?.Propietario?.Nombres
                            @consulta.Mascota?.Propietario?.Apellidos
                        </td>

                        <td>
                            @consulta.FechaHora.ToString("dd/MM/yyyy HH:mm")
                        </td>

                        <td>@consulta.Motivo</td>

                        <td>@consulta.Diagnostico</td>

                        <td>
                            @if (consulta.CitaId.HasValue)
                            {
                                <span class="badge bg-success">
                                    Cita #@consulta.CitaId
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Sin cita
                                </span>
                            }
                        </td>

                        <td>
                            <div class="d-flex flex-wrap gap-1">

                                <a asp-action="Details"
                                   asp-route-id="@consulta.Id"
                                   class="btn btn-sm btn-info text-white">
                                    Ver detalles
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@consulta.Id"
                                   class="btn btn-sm btn-warning">
                                    Editar
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@consulta.Id"
                                   class="btn btn-sm btn-danger">
                                    Eliminar
                                </a>

                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
