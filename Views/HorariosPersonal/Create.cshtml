
@model Huellitas.Models.HorarioPersonal

@{
    ViewData["Title"] = "Registrar horario";
    var personal = ViewBag.Personal as Huellitas.Models.Personal;
}

<div class="container mt-4">

    <div class="mb-4">
        <h2>Registrar horario</h2>
        <p class="text-muted">
            Empleado: <strong>@personal?.Nombres @personal?.Apellidos</strong>
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Create"
                  asp-route-personalId="@Model.PersonalId"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="DiaSemana" class="form-label">
                        Día de la semana
                    </label>

                    <select asp-for="DiaSemana"
                            asp-items="ViewBag.DiasSemana"
                            class="form-select">
                        <option value="">Seleccione un día</option>
                    </select>

                    <span asp-validation-for="DiaSemana"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NumeroConsultorio" class="form-label">
                        Consultorio
                    </label>

                    <select asp-for="NumeroConsultorio" class="form-select">
                        <option value="">Seleccione un consultorio</option>
                        <option value="1">Consultorio 1</option>
                        <option value="2">Consultorio 2</option>
                        <option value="3">Consultorio 3</option>
                    </select>

                    <span asp-validation-for="NumeroConsultorio"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="HoraEntrada" class="form-label">
                        Hora de entrada
                    </label>

                    <input asp-for="HoraEntrada"
                           type="time"
                           asp-format="{0:hh\:mm}"
                           class="form-control" />

                    <span asp-validation-for="HoraEntrada"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="HoraSalida" class="form-label">
                        Hora de salida
                    </label>

                    <input asp-for="HoraSalida"
                           type="time"
                           asp-format="{0:hh\:mm}"
                           class="form-control" />

                    <span asp-validation-for="HoraSalida"
                          class="text-danger"></span>
                </div>

                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i>
                    Puedes registrar varios turnos en un mismo día,
                    siempre que no se superpongan.
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-save"></i>
                        Guardar horario
                    </button>

                    <a asp-action="Index"
                       asp-route-personalId="@Model.PersonalId"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}