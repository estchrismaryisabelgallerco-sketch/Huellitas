
@model Huellitas.Models.HorarioPersonal

@{
    ViewData["Title"] = "Eliminar horario";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2>Eliminar horario</h2>
        <p class="text-muted">
            Confirma si deseas eliminar este turno.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle"></i>
                ¿Estás seguro de que deseas eliminar este horario?
                Esta acción no se puede deshacer.
            </div>

            <dl class="row">

                <dt class="col-sm-4">Empleado</dt>
                <dd class="col-sm-8">
                    @Model.Personal?.Nombres @Model.Personal?.Apellidos
                </dd>

                <dt class="col-sm-4">Día</dt>
                <dd class="col-sm-8">
                    @ViewBag.Dia
                </dd>

                <dt class="col-sm-4">Hora de entrada</dt>
                <dd class="col-sm-8">
                    @Model.HoraEntrada.ToString(@"hh\:mm")
                </dd>

                <dt class="col-sm-4">Hora de salida</dt>
                <dd class="col-sm-8">
                    @Model.HoraSalida.ToString(@"hh\:mm")
                </dd>

            </dl>

            <form asp-action="Delete"
                  asp-route-personalId="@Model.PersonalId"
                  asp-route-id="@Model.Id"
                  method="post">

                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i>
                    Confirmar eliminación
                </button>

                <a asp-action="Index"
                   asp-route-personalId="@Model.PersonalId"
                   class="btn btn-outline-secondary">
                    Cancelar
                </a>

            </form>

        </div>
    </div>

</div>