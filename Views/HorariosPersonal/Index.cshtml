
@model IEnumerable<Huellitas.Models.HorarioPersonal>

@{
    ViewData["Title"] = "Horarios del personal";
    var personal = ViewBag.Personal as Huellitas.Models.Personal;

    var dias = new Dictionary<DayOfWeek, string>
    {
        { DayOfWeek.Monday, "Lunes" },
        { DayOfWeek.Tuesday, "Martes" },
        { DayOfWeek.Wednesday, "Miércoles" },
        { DayOfWeek.Thursday, "Jueves" },
        { DayOfWeek.Friday, "Viernes" },
        { DayOfWeek.Saturday, "Sábado" },
        { DayOfWeek.Sunday, "Domingo" }
    };
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Horarios de trabajo</h2>
            <p class="text-muted mb-1">
                Administración de turnos del personal.
            </p>
            <h5 class="mt-2">
                <i class="bi bi-person-badge"></i>
                @personal?.Nombres @personal?.Apellidos
            </h5>
        </div>

        <a asp-action="Create"
           asp-route-personalId="@personal?.Id"
           class="btn btn-success">
            <i class="bi bi-plus-circle"></i>
            Agregar horario
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Mensaje"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-calendar-x fs-1 text-muted"></i>
                <h5 class="mt-3">No hay horarios registrados</h5>
                <p class="text-muted">
                    Este empleado todavía no tiene turnos asignados.
                </p>
                <a asp-action="Create"
                   asp-route-personalId="@personal?.Id"
                   class="btn btn-success">
                    Registrar primer horario
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Día</th>
                            <th>Consultorio</th>
                            <th>Hora de entrada</th>
                            <th>Hora de salida</th>
                            <th>Duración</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var horario in Model)
                        {
                            <tr>
                                <td>
                                    <strong>
                                        @dias[horario.DiaSemana]
                                    </strong>
                                </td>

                                <td>
                                    @if (horario.NumeroConsultorio >= 1 && horario.NumeroConsultorio <= 3)
                                    {
                                        <span>Consultorio @horario.NumeroConsultorio</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Sin asignar</span>
                                    }
                                </td>

                                <td>
                                    @horario.HoraEntrada.ToString(@"hh\:mm")
                                </td>

                                <td>
                                    @horario.HoraSalida.ToString(@"hh\:mm")
                                </td>

                                <td>
                                    @{
                                        var duracion =
                                            horario.HoraSalida - horario.HoraEntrada;
                                    }
                                    @duracion.ToString(@"hh\:mm") horas
                                </td>

                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">

                                        <a asp-action="Edit"
                                           asp-route-personalId="@personal?.Id"
                                           asp-route-id="@horario.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil"></i>
                                            Editar
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-personalId="@personal?.Id"
                                           asp-route-id="@horario.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                            Eliminar
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    }

    <div class="mt-3">
        <a asp-controller="Personal"
           asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
            Volver al personal
        </a>
    </div>

</div>