@model IEnumerable<Huellitas.Models.Cita>

@{
    ViewData["Title"] = "Citas";
    bool esAdministrador = User.IsInRole("Administrador");
}

<h1>Gestión de Citas</h1>

@if (!esAdministrador)
{
    <p>
        <a asp-action="Create" class="btn btn-primary">
            Registrar nueva cita
        </a>
    </p>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        No hay citas registradas todavía.
    </div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Mascota</th>
                <th>Propietario</th>
                <th>Veterinario</th>
                <th>Fecha y hora</th>
                <th>Motivo</th>
                <th>Estado</th>
                <th>Consultorio</th>
                @if (!esAdministrador)
                {
                    <th class="text-center">Acciones</th>
                }
            </tr>
        </thead>

        <tbody>
            @foreach (var cita in Model)
            {
                <tr>
                    <td>
                        @(cita.Mascota?.Nombre ?? "Sin mascota")
                    </td>

                    <td>
                        @(cita.Mascota?.Propietario != null
                            ? cita.Mascota.Propietario.Nombres + " " +
                              cita.Mascota.Propietario.Apellidos
                            : "Sin propietario")
                    </td>

                    <td>
                        @(cita.Personal != null
                            ? $"{cita.Personal.Nombres} {cita.Personal.Apellidos}"
                            : "Sin asignar")
                    </td>

                    <td>
                        @cita.FechaHora.ToString("dd/MM/yyyy HH:mm")
                    </td>

                    <td>@cita.Motivo</td>

                    <td>
                        @cita.Estado
                    </td>

                    <td>
                        @if (cita.NumeroConsultorio >= 1 && cita.NumeroConsultorio <= 3)
                        {
                            <span>Consultorio @cita.NumeroConsultorio</span>
                        }
                        else
                        {
                            <span class="text-muted">Sin asignar</span>
                        }
                    </td>

                    @if (!esAdministrador)
                    {
                        <td class="text-center">
                            <a asp-action="Edit"
                               asp-route-id="@cita.Id"
                               class="btn btn-warning btn-sm">
                                Editar
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@cita.Id"
                               class="btn btn-danger btn-sm">
                                Eliminar
                            </a>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
