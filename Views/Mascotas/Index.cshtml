
@model IEnumerable<Huellitas.Models.Mascota>

@{
    ViewData["Title"] = "Mascotas";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Mascotas</h1>
            <p class="text-muted mb-0">
                Administración de mascotas registradas en HUELLITAS.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            Registrar mascota
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Todavía no hay mascotas registradas.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Nombre</th>
                        <th>Especie</th>
                        <th>Raza</th>
                        <th>Sexo</th>
                        <th>Propietario</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var mascota in Model)
                    {
                        <tr>
                            <td>@mascota.Nombre</td>
                            <td>@mascota.Especie</td>
                            <td>@mascota.Raza</td>
                            <td>@mascota.Sexo</td>

                            <td>
                                @(mascota.Propietario != null
                                    ? $"{mascota.Propietario.Nombres} {mascota.Propietario.Apellidos}"
                                    : "Sin propietario")
                            </td>

                            <td class="text-end text-nowrap">

                                @if (User.IsInRole("Administrador") ||
                                     User.IsInRole("Veterinario"))
                                {
                                    <a asp-action="Historial"
                                       asp-route-id="@mascota.Id"
                                       class="btn btn-success btn-sm me-1">
                                        <i class="bi bi-journal-medical"></i>
                                        Historial clínico
                                    </a>
                                }

                                <a asp-action="Edit"
                                   asp-route-id="@mascota.Id"
                                   class="btn btn-warning btn-sm me-1">
                                    Editar
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@mascota.Id"
                                   class="btn btn-danger btn-sm">
                                    Eliminar
                                </a>

                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

</div>