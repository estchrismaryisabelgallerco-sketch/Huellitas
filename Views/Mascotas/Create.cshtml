@model Huellitas.Models.Mascota

@{
    ViewData["Title"] = "Registrar mascota";
}

<div class="container mt-4">
    <h1>Registrar mascota</h1>
    <p class="text-muted">Complete los datos de la mascota.</p>

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create" method="post">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert alert-danger"></div>
                }

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label">Nombre</label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Especie" class="form-label">Especie</label>
                    <input asp-for="Especie" class="form-control" placeholder="Ej. Perro, Gato..." />
                    <span asp-validation-for="Especie" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Raza" class="form-label">Raza</label>
                    <input asp-for="Raza" class="form-control" />
                    <span asp-validation-for="Raza" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Sexo" class="form-label">Sexo</label>
                    <select asp-for="Sexo" class="form-select">
                        <option value="">Seleccione el sexo</option>
                        <option value="Macho">Macho</option>
                        <option value="Hembra">Hembra</option>
                    </select>
                    <span asp-validation-for="Sexo" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FechaNacimiento" class="form-label">Fecha de nacimiento</label>
                    <input asp-for="FechaNacimiento" type="date" class="form-control" />
                    <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FotoUrl" class="form-label">URL de fotografía (opcional)</label>
                    <input asp-for="FotoUrl" class="form-control" />
                    <span asp-validation-for="FotoUrl" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PropietarioId" class="form-label">Propietario</label>
                    <select asp-for="PropietarioId" asp-items="ViewBag.PropietarioId" class="form-select">
                        <option value="">Seleccione un propietario</option>
                    </select>
                    <span asp-validation-for="PropietarioId" class="text-danger"></span>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">Registrar mascota</button>
                    <a asp-action="Index" class="btn btn-secondary">Volver</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
